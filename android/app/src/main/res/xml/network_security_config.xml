<?xml version="1.0" encoding="utf-8"?>
<!-- The newsroom server is usually a private box on the LAN, reachable over
     plain HTTP. Cleartext stays allowed so a self-hosted instance just works. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
